---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import { profile } from '../data/profile';
interface Props { title: string; }
const { title } = Astro.props;
const description = 'João Victor Lourenço, engenheiro de software. Backend, sistemas distribuídos e produtos digitais com Go, Node.js, NestJS e Python.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9f6" />
    <meta name="google-site-verification" content="4Y9FfFYiim01hecddemEpLY-uTldVF207yiJFYJDzjw" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('portfolio-theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light'
          ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>
    <NavBar />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <a href="#hero" class="footer-name">João<span>.</span></a>
      <p>Feito com intenção. Construído com Astro.</p>
      <span>© {new Date().getFullYear()} {profile.name}</span>
    </footer>
  </body>
</html>
