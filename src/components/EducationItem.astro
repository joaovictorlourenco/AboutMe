---
import { Icon } from 'astro-icon/components';
import type { Education } from '../data/education';
interface Props { education: Education; }
const { education: edu } = Astro.props;
---
<article class="education-item">
  <Icon name="mdi:school-outline" class="education-icon" />
  <p class="education-period">{edu.period.replace(/[–—]/g, '-')}</p>
  <h3>{edu.degree}</h3>
  <p class="education-institution">{edu.institution.replace(/[–—]/g, '-')}</p>
  {edu.description && <p class="education-description">{edu.description}</p>}
</article>
