---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Experience } from '../data/experience';
interface Props { experience: Experience; current?: boolean; }
const { experience: exp, current = false } = Astro.props;
const period = exp.period.replace(/[–—]/g, '-');
---
<li class:list={['experience', { 'experience-current': current }]}>
  <div class="experience-rail" aria-hidden="true">
    <div class="company-logo">
      <Image src={exp.logo} alt="" width={80} loading="lazy" class="company-logo-image" />
    </div>
  </div>
  <article class="experience-body">
    <div class="experience-meta">
      <p>{period}</p>
      {current && <span class="current-label">Experiência atual</span>}
      {exp.isAcademic && <span class="academic-label">Empresa júnior</span>}
    </div>
    <h3>{exp.company}</h3>
    <p class="experience-role">{exp.role}</p>
    <p class="experience-summary">{exp.description[0]}</p>
    {exp.positions && (
      <div class="experience-positions" aria-label="Cargos nesta empresa">
        {exp.positions.map(position => (
          <div class="experience-position">
            <h4>{position.role}</h4>
            <p>{position.period}</p>
          </div>
        ))}
      </div>
    )}
    {exp.description.length > 1 && (
      <details>
        <summary>Mais sobre a experiência <Icon name="mdi:plus" /></summary>
        <ul>{exp.description.slice(1).map(item => <li>{item}</li>)}</ul>
      </details>
    )}
    <ul class="tech-tags" aria-label="Tecnologias utilizadas">
      {exp.techs.map(tech => <li>{tech}</li>)}
    </ul>
  </article>
</li>
