---
import ExperienceItem from './ExperienceItem.astro';
import { experiences } from '../data/experience';
---

<div class="timeline">
  <div class="timeline__line" aria-hidden="true"></div>
  <ul class="timeline__list">
    {
      experiences.map((exp) => (
        <li class="timeline__item">
          <span class="timeline__dot" aria-hidden="true" />
          <ExperienceItem experience={exp} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .timeline {
    position: relative;
    width: 100%;
    max-width: 40rem;
  }

  .timeline__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.5rem;
    width: 1px;
    background-color: var(--color-border);
  }

  .timeline__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .timeline__item {
    position: relative;
    padding-left: var(--space-xl);
  }

  .timeline__dot {
    position: absolute;
    top: 1.25rem;
    left: 0;
    width: 0.625rem;
    height: 0.625rem;
    background-color: var(--color-primary);
    border-radius: 50%;
    border: 2px solid var(--color-bg);
  }

  @media (max-width: 480px) {
    .timeline__line {
      display: none;
    }

    .timeline__item {
      padding-left: 0;
    }

    .timeline__dot {
      display: none;
    }
  }
</style>
