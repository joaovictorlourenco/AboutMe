---
import { Icon } from 'astro-icon/components';
import { CardContainer } from './ui/3d-card';
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class:list={['project', `project-${project.visual}`, { 'project-featured': project.featured }]}>
  <CardContainer client:visible className="project-art-container">
    <div class={`project-art art-${project.visual}`} aria-hidden="true">
      {project.visual === 'groot' && <><span class="art-kicker">Intelligence, in your terminal.</span><div class="groot-mark"><span>&gt;_</span><strong>groot<span>.</span></strong></div><span class="art-bottom">Go powered. Human centered.</span></>}
      {project.visual === 'pivot' && <><div class="pivot-field"><span class="pivot-arm"></span></div><strong class="pivot-wordmark">pivot<span>smart</span></strong></>}
      {project.visual === 'idpro' && <><div class="idpro-geometry"><span></span><span></span><span></span></div><strong class="idpro-wordmark">ID<span>PRO</span><small>Projetos de irrigação.</small></strong></>}
    </div>
  </CardContainer>
  <div class="project-info">
    <div class="project-meta"><span>{project.category}</span><span class="project-status">{project.status}</span></div>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <ul class="tech-tags" aria-label={`Tecnologias de ${project.name}`}>{project.techs.map(tech => <li>{tech}</li>)}</ul>
    {project.githubUrl ? <a href={project.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">Explorar código <Icon name="mdi:arrow-top-right" /></a> : <a href="#contato" class="project-link" aria-label={`Conversar sobre o projeto ${project.name}`}>Conversar sobre o projeto <Icon name="mdi:arrow-top-right" /></a>}
  </div>
</article>
