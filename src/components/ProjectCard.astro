---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class={`project-card ${project.featured ? 'project-card--featured' : ''}`}>
  <div class="project-card__image-wrapper">
    {project.image ? (
      <img src={project.image} alt={`Screenshot do projeto ${project.name}`} class="project-card__image" loading="lazy" />
    ) : (
      <div class="project-card__placeholder">
        <span class="project-card__placeholder-text">{project.name}</span>
      </div>
    )}
    {project.featured && <span class="project-card__badge">Destaque</span>}
  </div>

  <div class="project-card__content">
    <h3 class="project-card__name">{project.name}</h3>
    <p class="project-card__description">{project.description}</p>

    <ul class="project-card__techs" aria-label="Tecnologias utilizadas">
      {project.techs.map((tech) => (
        <li class="project-card__tech">{tech}</li>
      ))}
    </ul>

    <div class="project-card__links">
      <a
        href={project.githubUrl}
        class="project-card__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Ver código do ${project.name} no GitHub`}
      >
        <Icon name="mdi:github" class="project-card__link-icon" />
        <span>GitHub</span>
      </a>
      {project.deployUrl && (
        <a
          href={project.deployUrl}
          class="project-card__link project-card__link--secondary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver projeto ${project.name} no ar`}
        >
          <Icon name="mdi:open-in-new" class="project-card__link-icon" />
          <span>Ver projeto</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px oklch(0.30 0.02 130 / 0.06);
  }

  .project-card--featured {
    border-color: var(--color-primary);
    box-shadow: 0 1px 3px oklch(0.40 0.08 130 / 0.12);
  }

  .project-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-surface), var(--color-primary-surface));
  }

  .project-card__placeholder-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.5;
  }

  .project-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-bg);
    background-color: var(--color-primary);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    flex: 1;
  }

  .project-card__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
    margin: 0;
  }

  .project-card__description {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .project-card__techs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-card__tech {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary-dark);
    background-color: var(--color-primary-surface);
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    line-height: 1.3;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .project-card__link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-bg);
    background-color: var(--color-ink);
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    text-decoration: none;
    line-height: 1;
    transition: background-color 0.2s ease-out;
  }

  .project-card__link:hover {
    background-color: var(--color-primary);
  }

  .project-card__link--secondary {
    background-color: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  .project-card__link--secondary:hover {
    background-color: var(--color-primary-surface);
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .project-card__link-icon {
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
    .project-card:hover {
      transform: none;
    }
  }
</style>
