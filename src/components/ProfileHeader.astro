---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '../assets/joao-victor-profissional-v2.png';
import { BackgroundBeamsWithCollision } from './ui/background-beams-with-collision';
import { profile } from '../data/profile';
---
<BackgroundBeamsWithCollision client:load />
<div class="hero-copy">
  <p class="hero-intro"><span class="intro-line" aria-hidden="true"></span><span>João Victor Lourenço<small>Engenheiro de Software</small></span></p>
  <h1><span class="hero-title-mask"><span class="hero-title-line">Engenharia que</span></span><span class="hero-title-mask hero-accent"><span class="hero-title-line">vira produto.</span></span></h1>
  <p class="hero-description">Do backend à experiência de quem usa. Construo sistemas escaláveis e produtos que resolvem problemas reais.</p>
  <div class="hero-actions">
    <a class="button button-primary" href="#projetos">Explorar projetos <Icon name="mdi:arrow-bottom-right" /></a>
    <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="mdi:github" /> Meu GitHub <Icon name="mdi:arrow-top-right" /></a>
  </div>
</div>
<div class="hero-visual">
  <div class="portrait-orbit orbit-one" aria-hidden="true"></div><div class="portrait-orbit orbit-two" aria-hidden="true"></div>
  <div class="portrait-container">
    <figure class="portrait-figure">
      <Image src={portrait} alt="João Victor Lourenço, engenheiro de software, sorrindo" width={610} format="webp" quality={85} loading="eager" fetchpriority="high" class="portrait-image" />
    </figure>
  </div>
  <div class="hero-note"><span class="note-symbol" aria-hidden="true"><Icon name="mdi:code-tags" /></span><div><strong>Backend com visão de produto.</strong><span>Go, Node.js & um pouco de curiosidade.</span></div></div>
</div>
